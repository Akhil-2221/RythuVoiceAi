# ---- Gnani ----
PRISMA_API_URL=
GNANI_API_KEY=          # Prisma STT key
PRISMA_API_KEY=         # Timbre TTS key (SDK)
# PRISMA_AUTH_HEADER=X-API-Key-ID
# ---- Groq ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b  # Vision-capable Groq model
# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
MAX_AUDIO_MB=10
MAX_IMAGE_MB=5
RATE_LIMIT_PER_MIN=30
DATABASE_PATH=data/rythuvoice.db
# ---- RAG ----
EMBEDDING_BACKEND=lexical            # or sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # or google/embeddinggemma-300m (needs HF_TOKEN)
# HF_TOKEN=
RAG_TOP_K=4
RAG_MIN_SCORE=0.30
